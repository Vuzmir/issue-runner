# The bundles are generated by `npm run build`; review the sources, not these files.
dist/index.js linguist-generated=true
dist/index.js -diff
worker/index.js linguist-generated=true
worker/index.js -diff

# Git runs this via its shebang line; CRLF would break that on a Windows checkout.
.githooks/pre-commit text eol=lf

# The worker runs this with `sh`, on whatever OS the runner happens to be; a Windows checkout
# converting it to CRLF would hand `sh` lines it cannot parse.
wait-for.sh text eol=lf
